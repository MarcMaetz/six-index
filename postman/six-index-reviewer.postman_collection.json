{
  "info": {
    "_postman_id": "fed703bb-9ae7-4baf-a21c-f42ec10f15ba",
    "name": "SIX Index Reviewer",
    "description": "Requests for the SIX Index Reviewer (SMI Q3 2026 review) take-home. Repo: github.com/MarcMaetz/six-index. Start the app with `./gradlew bootRun`, then run the Indices folder in order: list the configured indices, check a review's input, run the review (201 with a summary; the full report is stored as JSON), then list and fetch the stored reports. \"Run review\" saves the new report's id in the `reportId` collection variable for the requests after it. Each request has test scripts with the expected Q3 results. The OpenAPI spec at /api-docs is the source of truth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Ops",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          },
          "response": []
        },
        {
          "name": "Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const info = pm.response.json();",
                  "pm.test('application version', () => pm.expect(info.build.version).to.be.a('string').and.not.empty);",
                  "pm.test('Git commit', () => pm.expect(info.git.commit.id).to.match(/^[0-9a-f]{7,}$/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/info",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "info"]
            },
            "description": "Application version (build-info.properties) and Git branch, commit and commit time (git.properties), both generated by Gradle. The same version and revision are recorded in every review report under `build`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Docs",
      "item": [
        {
          "name": "OpenAPI spec",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api-docs",
              "host": ["{{baseUrl}}"],
              "path": ["api-docs"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Indices",
      "item": [
        {
          "name": "List indices",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const smi = pm.response.json().find(i => i.name === 'SMI');",
                  "pm.test('SMI is configured', () => pm.expect(smi).to.exist);",
                  "pm.test('SMI parameters', () => {",
                  "  pm.expect(smi.methodology).to.include('v3.40');",
                  "  pm.expect(smi.universe).to.eql('SPI');",
                  "  pm.expect(smi.constituentCount).to.eql(20);",
                  "  pm.expect(smi.directSelectionRank).to.eql(18);",
                  "  pm.expect(smi.bufferEndRank).to.eql(22);",
                  "  pm.expect(smi.weightCap).to.eql(0.18);",
                  "});",
                  "pm.test('2026-Q3 review period', () => {",
                  "  const q3 = smi.reviewPeriods.find(p => p.id === '2026-Q3');",
                  "  pm.expect(q3.cutOffDate).to.eql('2026-09-10');",
                  "  pm.expect(q3.reviewDate).to.eql('2026-09-21');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/indices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "indices"]
            },
            "description": "Configured indices and their review periods, from config/indices.yml."
          },
          "response": []
        },
        {
          "name": "Check review input (SMI 2026-Q3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('205 securities in the universe on the review date', () => pm.expect(body.universeSizeOnReviewDate).to.eql(205));",
                  "pm.test('market data: 205 at cut-off, 204 at review date (166 missing)', () => {",
                  "  pm.expect(body.securityDataCountByDate['2026-09-10']).to.eql(205);",
                  "  pm.expect(body.securityDataCountByDate['2026-09-21']).to.eql(204);",
                  "});",
                  "pm.test('20 current constituents', () => pm.expect(body.currentComposition).to.have.lengthOf(20));",
                  "pm.test('3 input files, universe first', () => {",
                  "  pm.expect(body.files).to.have.lengthOf(3);",
                  "  pm.expect(body.files[0]).to.eql('data/SMI/2026-Q3/spi_universe.csv');",
                  "});",
                  "pm.test('only warning: 204 duplicate universe rows (A1)', () => {",
                  "  pm.expect(body.warnings).to.have.lengthOf(1);",
                  "  pm.expect(body.warnings[0].source).to.eql('spi_universe.csv');",
                  "  pm.expect(body.warnings[0].securityIds).to.have.lengthOf(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/indices/SMI/reviews/2026-Q3/input",
              "host": ["{{baseUrl}}"],
              "path": ["api", "indices", "SMI", "reviews", "2026-Q3", "input"]
            },
            "description": "Loads and validates the input of a review from data/SMI/2026-Q3 without running it: files read, data counts per date, current composition and data-quality warnings."
          },
          "response": []
        },
        {
          "name": "Check review input: unknown period (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('problem detail names the period', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.title).to.eql('Not configured');",
                  "  pm.expect(body.detail).to.eql('Review period 2026-Q4 is not configured for SMI');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/indices/SMI/reviews/2026-Q4/input",
              "host": ["{{baseUrl}}"],
              "path": ["api", "indices", "SMI", "reviews", "2026-Q4", "input"]
            },
            "description": "A review period that isn't in config/indices.yml returns a 404 problem response (RFC 9457)."
          },
          "response": []
        },
        {
          "name": "Run review (SMI 2026-Q3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Location points to the stored report', () => {",
                  "  const location = pm.response.headers.get('Location');",
                  "  pm.expect(location).to.match(/\\/api\\/indices\\/SMI\\/reviews\\/2026-Q3\\/reports\\/\\d{8}T\\d{15}Z$/);",
                  "  pm.collectionVariables.set('reportUrl', location);",
                  "  pm.collectionVariables.set('reportId', location.substring(location.lastIndexOf('/') + 1));",
                  "});",
                  "const r = pm.response.json();",
                  "pm.test('summary carries the report id and its URL (same as Location)', () => {",
                  "  pm.expect(r.reportId).to.eql(pm.collectionVariables.get('reportId'));",
                  "  pm.expect(r.reportUrl).to.eql(pm.collectionVariables.get('reportUrl'));",
                  "});",
                  "pm.test('review status: completed with warnings (duplicates, 166 excluded)', () => {",
                  "  pm.expect(r.status).to.eql('COMPLETED_WITH_WARNINGS');",
                  "  pm.expect(r.statusReasons.map(s => s.relevance)).to.eql(['NO_DATA_LOST', 'ESTIMATED_FAR_BELOW_BUFFER']);",
                  "  pm.expect(r.statusReasons[1].securityId).to.eql('166');",
                  "});",
                  "pm.test('20 constituents', () => pm.expect(r.constituents).to.have.lengthOf(20));",
                  "pm.test('joiner 177', () => pm.expect(r.joiners.map(j => j.securityId)).to.eql(['177']));",
                  "pm.test('leaver 103, below the buffer', () => {",
                  "  pm.expect(r.leavers.map(l => l.securityId)).to.eql(['103']);",
                  "  pm.expect(r.leavers[0].reason).to.eql('BELOW_BUFFER');",
                  "});",
                  "pm.test('155 and 205 capped at 18%', () => {",
                  "  const capped = r.constituents.filter(c => c.capped);",
                  "  pm.expect(capped.map(c => c.securityId)).to.eql(['155', '205']);",
                  "  capped.forEach(c => pm.expect(c.weightPercent).to.eql(18));",
                  "});",
                  "pm.test('no weight above the cap, weights add up to 100%', () => {",
                  "  r.constituents.forEach(c => pm.expect(c.weightPercent).to.be.at.most(18));",
                  "  const sum = r.constituents.reduce((s, c) => s + c.weightPercent, 0);",
                  "  pm.expect(sum).to.be.closeTo(100, 0.00001);",
                  "});",
                  "pm.test('audit trail only in the stored report', () => pm.expect(r).to.not.have.property('ranking'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/indices/SMI/reviews/2026-Q3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "indices", "SMI", "reviews", "2026-Q3"]
            },
            "description": "Runs the SMI Q3 2026 review, stores the full report and returns a summary: report id and `reportUrl`, status with structured reasons, the 20 constituents with weights (joiner, capped), joiners and leavers. Returns 201 Created; `reportUrl` in the body and the Location header both point to the stored report with the audit trail, and the test script saves them as the collection variables `reportUrl` and `reportId` for the stored-report requests below. Weights are in percent, rounded for display only."
          },
          "response": []
        },
        {
          "name": "Run review: unknown index (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('problem detail names the index', () => pm.expect(pm.response.json().detail).to.eql('Index XYZ is not configured'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/indices/XYZ/reviews/2026-Q3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "indices", "XYZ", "reviews", "2026-Q3"]
            },
            "description": "An index that isn't in config/indices.yml returns a 404 problem response (RFC 9457)."
          },
          "response": []
        },
        {
          "name": "List stored reports (SMI 2026-Q3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const runs = pm.response.json();",
                  "pm.test('contains the run just made', () => pm.expect(runs.map(r => r.id)).to.include(pm.collectionVariables.get('reportId')));",
                  "pm.test('oldest first', () => {",
                  "  const times = runs.map(r => r.generatedAt);",
                  "  pm.expect(times).to.eql([...times].sort());",
                  "});",
                  "pm.test('every run completed with warnings', () => runs.forEach(r => pm.expect(r.status).to.eql('COMPLETED_WITH_WARNINGS')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/indices/SMI/reviews/2026-Q3/reports",
              "host": ["{{baseUrl}}"],
              "path": ["api", "indices", "SMI", "reviews", "2026-Q3", "reports"]
            },
            "description": "Lists the stored runs of the SMI Q3 2026 review, oldest first: id (UTC generation time), index, review period, generation time and status. Run \"Run review (SMI 2026-Q3)\" first."
          },
          "response": []
        },
        {
          "name": "Get stored report (SMI 2026-Q3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('same Q3 result as the run', () => {",
                  "  pm.expect(r.status).to.eql('COMPLETED_WITH_WARNINGS');",
                  "  pm.expect(r.joiners.map(j => j.securityId)).to.eql(['177']);",
                  "  pm.expect(r.leavers.map(l => l.securityId)).to.eql(['103']);",
                  "  pm.expect(r.constituents).to.have.lengthOf(20);",
                  "});",
                  "pm.test('buffer incumbents 160 and 81 kept over new 249 and 28', () => {",
                  "  const buffer = r.ranking.filter(e => e.rank > 18 && e.rank <= 22);",
                  "  pm.expect(buffer.map(e => [e.securityId, e.selection])).to.eql([",
                  "    ['249', 'NOT_SELECTED_BUFFER_FULL'], ['28', 'NOT_SELECTED_BUFFER_FULL'],",
                  "    ['160', 'SELECTED_BUFFER_INCUMBENT'], ['81', 'SELECTED_BUFFER_INCUMBENT']]);",
                  "});",
                  "pm.test('155 and 205 capped in one round', () => pm.expect(r.cappingRounds).to.eql([['155', '205']]));",
                  "pm.test('166 excluded (no review-date data)', () => pm.expect(r.excluded.map(e => e.securityId)).to.eql(['166']));",
                  "pm.test('rulebook version recorded in the parameters', () => pm.expect(r.parameters.methodology).to.include('v3.40'));",
                  "pm.test('build version and revision recorded', () => {",
                  "  pm.expect(r.build.version).to.be.a('string').and.not.empty;",
                  "  pm.expect(r.build.revision).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('FFMCAP of leaver 103 recomputable from its entry: 165.7 x 45867891 x 1', () => {",
                  "  const e = r.ranking.find(x => x.securityId === '103');",
                  "  pm.expect([e.rank, e.price, e.shares, e.freeFloat]).to.eql([35, 165.7, 45867891, 1]);",
                  "  pm.expect(e.ffmcap).to.be.closeTo(e.price * e.shares * e.freeFloat, 0.01);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/indices/SMI/reviews/2026-Q3/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "indices", "SMI", "reviews", "2026-Q3", "reports", "{{reportId}}"]
            },
            "description": "Returns one stored report exactly as it was written: the full result with the audit trail (parameters, full ranking with a decision per security, capping rounds, exclusions, input files, warnings, build). `reportId` is set by \"Run review (SMI 2026-Q3)\" from its Location header."
          },
          "response": []
        },
        {
          "name": "Get stored report: unknown id (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('problem title', () => pm.expect(pm.response.json().title).to.eql('Report not found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/indices/SMI/reviews/2026-Q3/reports/20000101T000000000Z",
              "host": ["{{baseUrl}}"],
              "path": ["api", "indices", "SMI", "reviews", "2026-Q3", "reports", "20000101T000000000Z"]
            },
            "description": "A report id that was never stored returns a 404 problem response (RFC 9457)."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "description": "Local bootRun instance"
    },
    {
      "key": "reportId",
      "value": ""
    },
    {
      "key": "reportUrl",
      "value": ""
    }
  ]
}
